# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 本地依赖（可选安装 selenium 等）
vendor/
.piptmp/
.pipcache/
*.whl

# 打包产物（用 python tools/build_exe.py 重新生成）
dist/
build/
*.spec.bak
.pyinstaller-cache/
.selenium-cache/

# 浏览器驱动（二进制，按 README §6 自行下载，不入库）
drivers/*
!drivers/.gitkeep

# 运行期数据（含各人任务配置与答案库，不入库）
data/*.json
data/*.json.bak
logs/
run/

# 编辑器 / IDE / 截图临时文件
.idea/
.vscode/
*.swp
*.tmp
